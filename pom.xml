<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.schemaevo</groupId>
  <artifactId>schemaevo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>schemaevo</name>
  <description>Schema evolution compatibility checker for Avro and JSON Schema</description>
  <url>https://github.com/hellpuffyt/schemaevo</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <avro.version>1.12.0</avro.version>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.3</junit.version>
    <picocli.version>4.7.6</picocli.version>
    <spotless.skip>true</spotless.skip>
    <spotbugs.skip>true</spotbugs.skip>
    <spotless.version>2.43.0</spotless.version>
    <spotbugs.version>4.8.6.4</spotbugs.version>
    <main.class>com.schemaevo.cli.Main</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>${avro.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.26.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>schemaevo</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        google-java-format reaches into internal javac APIs, and Spotless
        cannot run on JDK 25: it dies with
          NoSuchMethodError: Log$DeferredDiagnosticHandler.getDiagnostics()
        The project itself is fine there (all tests pass on 25), so the
        formatting gate is bound to the `quality-gate` profile below, which
        activates only on JDK 21. Formatting is a property of the source, not
        of the JDK that checks it, so checking it once is enough.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <skip>${spotless.skip}</skip>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.version}</version>
        <configuration>
          <skip>${spotbugs.skip}</skip>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Run the static-analysis gates only where the tools actually work.
      Spotless cannot run on JDK 25 (google-java-format uses internal javac
      APIs that moved), and SpotBugs cannot read JDK 25 bytecode at all:
        java.lang.IllegalArgumentException: Unsupported class file major
        version 69
      Neither is a defect in this project, whose 105 tests pass on JDK 25.
      Both gates are properties of the source rather than of the JDK running
      them, so checking them once on the baseline JDK is enough. JDK 21
      is the project's baseline and the JDK this gate is defined against; on
      JDK 25 google-java-format cannot run at all (see the note on the plugin).
    -->
    <profile>
      <id>quality-gate</id>
      <activation>
        <jdk>[21,22)</jdk>
      </activation>
      <properties>
        <spotless.skip>false</spotless.skip>
        <spotbugs.skip>false</spotbugs.skip>
      </properties>
    </profile>
  </profiles>
</project>
